// Array extensions for turtle written in turtle!
Buffer.push = (x) => {
    return this + [x];
};

Buffer.forEach = (f) => {
    for let i = 0; i < this.length; i = i + 1 {
        f(this[i], i);
    }
};

Buffer.find = (f) => {
    for let i = 0; i < this.length; i = i + 1 {
        if (f(this[i], i)) {
            return this[i];
        }
    }
    return nil;
};

func filter(f) {
    let result = BufferFrom([]);
    for let i = 0; i < this.length; i = i + 1 {
        if (f(this[i], i)) {
            result = result.push(this[i]);
        }
    }
    return result;
};

Buffer.filter = filter;

Buffer.slice = (start, end) => {
    if end == nil {
        end = this.length;
    }
    let result = BufferFrom([]);
    for let i = start; i < end; i = i + 1 {
        result = result.push(this[i]);
    }
    return result;
};

Buffer.map = (f) => {
    let result = BufferFrom([]);
    for let i = 0; i < this.length; i = i + 1 {
        result = result.push(f(this[i], i));
    }
    return result;
};

Buffer.join = (sep) => {
    if this.length == 0 return "";
    let result = "";
    for let i = 0; i < this.length - 1; i = i + 1 {
        result = result + this[i] + sep;
    }
    result = result + this[this.length - 1];
    return result;
};